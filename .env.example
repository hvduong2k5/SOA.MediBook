# ============================================================
# MediBook - biến môi trường cho môi trường local
# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env.
# ============================================================

# ---------- API Gateway ----------
GATEWAY_PORT=8080
GATEWAY_BASE_URL=http://localhost:8080

# ---------- Service URLs (gateway -> service) ----------
IDENTITY_SERVICE_URL=http://localhost:8081
CONSUMER_SERVICE_URL=http://localhost:8082
PROVIDER_SERVICE_URL=http://localhost:8083
SCHEDULING_SERVICE_URL=http://localhost:8084
CLINICAL_SERVICE_URL=http://localhost:8085
REMINDER_SERVICE_URL=http://localhost:8086

# ---------- Identity / JWT ----------
JWT_ISSUER=https://identity.medibook.local
JWT_AUDIENCE=medibook-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_SIGNING_KEY=change-me-in-local-only

# ---------- Web ----------
WEB_PORT=3000
WEB_API_BASE_URL=http://localhost:8080/v1
WEB_USE_MOCK=true

# ---------- Mock server ----------
MOCK_PORT=4010

# ---------- Observability ----------
LOG_LEVEL=debug
