# ============================================================
# MediBook - .gitignore
# ============================================================

# ---------- Secrets & environment ----------
.env
.env.*
!.env.example
!**/.env.example
*.local.env
secrets.json
*.pfx
*.p12
*.pem
*.key

# ---------- IDE / editors ----------
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.history/

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Node / frontend ----------
node_modules/
dist/
build/
out/
coverage/
.next/
.nuxt/
.svelte-kit/
.turbo/
.cache/
.vite/
*.tsbuildinfo

# ---------- .NET ----------
.vs/
bin/
obj/
artifacts/
TestResults/
*.user
*.suo
*.userosscache
*.sln.docstates

# ---------- Java / Kotlin ----------
.gradle/
target/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Go ----------
*.test
*.out

# ---------- Local infrastructure ----------
.docker/
docker-compose.override.yml
