# ============================================================
# MediBook Web - Biến môi trường local
# Sao chép thành .env (KHÔNG commit .env)
# ============================================================

# Base URL của API Gateway (không có trailing slash)
VITE_API_BASE_URL=http://localhost:8080

# Bật MSW mock trong trình duyệt khi backend chưa sẵn sàng (true | false)
VITE_USE_MOCK=true

# Endpoint SSE qua API Gateway
VITE_SSE_URL=http://localhost:8080/api/v1/realtime/stream
